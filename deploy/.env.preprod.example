# Copier vers deploy/.env.preprod sur le VPS (ne jamais committer le fichier réel)
# COMPOSE_PROJECT_NAME=portfolio-preprod

BACKEND_IMAGE=ghcr.io/OWNER/portfolio-backend:preprod
WEB_IMAGE=ghcr.io/OWNER/portfolio-web:preprod
# localhost only — plage dédiée portfolio (évite 80/443/3000/3001/8080)
WEB_PORT=50121

POSTGRES_USER=portfolio_preprod
POSTGRES_PASSWORD=change-me-strong-preprod-db-password
POSTGRES_DB=portfolio_preprod

JWT_SECRET=change-me-long-random-preprod-jwt
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-preprod-admin

OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

ISSUER_NAME=Axel Cella
ISSUER_SIRET=
ISSUER_ADDRESS=
ISSUER_VAT=
