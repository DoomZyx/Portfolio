# Copier vers deploy/.env.prod sur le VPS (ne jamais committer le fichier réel)
# Ne pas exporter COMPOSE_PROJECT_NAME dans le shell.
# Utiliser : ./deploy/scripts/compose-env.sh prod <cmd>
# ou : ./deploy/scripts/deploy.sh prod <backend_image> <web_image>

BACKEND_IMAGE=ghcr.io/OWNER/portfolio-backend:prod
WEB_IMAGE=ghcr.io/OWNER/portfolio-web:prod
# localhost only — plage dédiée portfolio (évite 80/443/3000/3001/8080)
WEB_PORT=50122

POSTGRES_USER=portfolio_prod
POSTGRES_PASSWORD=change-me-strong-prod-db-password
POSTGRES_DB=portfolio_prod

JWT_SECRET=change-me-long-random-prod-jwt
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-prod-admin

OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

ISSUER_NAME=Axel Cella
ISSUER_SIRET=
ISSUER_ADDRESS=
ISSUER_VAT=
ISSUER_EMAIL=
