{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API pour le portfolio d'Axel Cella",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "echo 'No build step required'",
    "pm2:start": "pm2 start ../ecosystem.config.js",
    "pm2:stop": "pm2 stop portfolio-backend",
    "pm2:restart": "pm2 restart portfolio-backend",
    "pm2:logs": "pm2 logs portfolio-backend",
    "migrate": "node scripts/migrate.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "test:recommendation": "node --test domain/ecommerce/recommendation.test.js",
    "test:validation": "node --test services/documentValidation.test.js services/leadValidation.test.js",
    "test": "node --test domain/ecommerce/recommendation.test.js services/documentValidation.test.js services/leadValidation.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.0"
  }
}
